/// ─── PAPERS SECTION ────────────────────────────────────────

dom.inject_css("
  .paper-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .paper-card {
    position: relative;
    padding: 2.5rem;
    border-radius: 1rem;
    background: var(--glass-bg);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid var(--glass-border);
    box-shadow: var(--glass-shadow);
    overflow: hidden;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.4s ease, box-shadow 0.4s ease;
  }
  .paper-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--cyan), var(--teal), var(--purple));
    opacity: 0.7;
  }
  .paper-card:hover {
    transform: translateY(-4px);
    border-color: rgba(6, 182, 212, 0.25);
    box-shadow: 0 16px 48px rgba(6, 182, 212, 0.08), var(--glass-shadow);
  }
  .paper-card .paper-type {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--cyan);
    margin-bottom: 1rem;
    opacity: 0.8;
  }
  .paper-card .paper-type .dot {
    width: 5px;
    height: 5px;
    background: var(--cyan);
    border-radius: 50%;
    animation: pulse 2s ease infinite;
  }
  .paper-card h3 {
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.4;
    margin-bottom: 0.75rem;
  }
  .paper-card .paper-abstract {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 1.25rem;
  }
  .paper-card .paper-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }
  .paper-card .meta-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.25rem 0.7rem;
    border-radius: 2rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    background: rgba(6, 182, 212, 0.08);
    color: var(--cyan);
    border: 1px solid rgba(6, 182, 212, 0.15);
  }
  .paper-link-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.7rem 1rem;
    border-radius: 0.6rem;
    background: var(--primary);
    border: 1px solid var(--glass-border);
    text-decoration: none;
    transition: border-color 0.2s, background 0.2s;
    cursor: pointer;
  }
  .paper-link-row:hover {
    border-color: rgba(6, 182, 212, 0.3);
    background: rgba(6, 182, 212, 0.06);
  }
  .paper-link-row .plr-num {
    width: 26px;
    height: 26px;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 800;
    color: var(--cyan);
    background: rgba(6, 182, 212, 0.1);
    border: 1px solid rgba(6, 182, 212, 0.2);
    flex-shrink: 0;
  }
  .paper-link-row .plr-title {
    font-size: 0.85rem;
    font-weight: 700;
    color: #e2e8f0;
  }
  .paper-link-row .plr-sub {
    font-size: 0.72rem;
    color: var(--text-secondary);
    margin-top: 1px;
  }
  .paper-link-row .plr-arrow {
    margin-left: auto;
    font-size: 0.8rem;
    color: var(--text-secondary);
    flex-shrink: 0;
  }
  .vert-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 0.5rem;
    margin-top: 0.75rem;
  }
  .vert-link {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.6rem 0.8rem;
    border-radius: 0.5rem;
    background: var(--primary);
    border: 1px solid var(--glass-border);
    text-decoration: none;
    transition: border-color 0.2s, background 0.2s;
    cursor: pointer;
  }
  .vert-link:hover {
    border-color: rgba(168, 85, 247, 0.4);
    background: rgba(168, 85, 247, 0.04);
  }
  .vert-link .vl-title {
    font-size: 0.78rem;
    font-weight: 700;
    color: #e2e8f0;
  }
  .vert-link .vl-sub {
    font-size: 0.65rem;
    color: var(--text-secondary);
  }
  .vert-link .vl-arrow {
    margin-left: auto;
    font-size: 0.75rem;
    color: var(--text-secondary);
    flex-shrink: 0;
  }
  .paper-card.paper-featured {
    border-color: rgba(6, 182, 212, 0.2);
    background: linear-gradient(135deg, rgba(6, 182, 212, 0.04), rgba(168, 85, 247, 0.03));
  }
  .paper-card.paper-featured::before {
    height: 4px;
    opacity: 1;
  }
  .upcoming-bar {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-top: 0.75rem;
  }
  .upcoming-pill {
    padding: 0.2rem 0.6rem;
    border-radius: 99px;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 600;
    color: var(--text-secondary);
    background: rgba(255,255,255,0.03);
    border: 1px solid var(--glass-border);
  }
  .patent-notice {
    text-align: center;
    margin-top: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    color: #ef4444;
    padding: 0.4rem 1rem;
    display: inline-block;
    border-radius: 99px;
    background: rgba(239, 68, 68, 0.06);
    border: 1px solid rgba(239, 68, 68, 0.12);
  }
  @media (max-width: 768px) {
    .paper-grid { grid-template-columns: 1fr; }
    .vert-grid { grid-template-columns: 1fr; }
  }
", "dwsc-papers-styles")

/// ─── Helper: create a core paper link row ───
function make_core_link(num, title, subtitle, doi) {
  return dom.create("a", {
    className: "paper-link-row reveal",
    attrs: { href: "https://doi.org/" + doi, target: "_blank", rel: "noopener" },
    children: [
      dom.create("span", { className: "plr-num", text: num }),
      dom.create("div", { children: [
        dom.create("div", { className: "plr-title", text: title }),
        dom.create("div", { className: "plr-sub", text: subtitle })
      ]}),
      dom.create("span", { className: "plr-arrow", text: "↗" })
    ]
  })
}

/// ─── Helper: create a vertical paper link ───
function make_vert_link(title, subtitle, doi) {
  return dom.create("a", {
    className: "vert-link reveal",
    attrs: { href: "https://doi.org/" + doi, target: "_blank", rel: "noopener" },
    children: [
      dom.create("div", { children: [
        dom.create("div", { className: "vl-title", text: title }),
        dom.create("div", { className: "vl-sub", text: subtitle })
      ]}),
      dom.create("span", { className: "vl-arrow", text: "↗" })
    ]
  })
}

