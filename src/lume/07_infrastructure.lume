dom.inject_css("
  .tech-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    justify-content: center;
    margin-top: 2rem;
  }
  .tech-badge {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.65rem 1.25rem;
    border-radius: 0.75rem;
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
