/// ─── UNIFIED INFRASTRUCTURE ────────────────────────────────

dom.inject_css("
  .infra-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
  }
  .infra-card {
    padding: 2rem 1.5rem;
    border-radius: 1rem;
    background: var(--glass-bg);
    backdrop-filter: blur(20px);
    border: 1px solid var(--glass-border);
    text-align: center;
    transition: transform 0.3s ease, border-color 0.3s ease;
    box-shadow: var(--glass-shadow);
  }
  .infra-card:hover {
    transform: translateY(-4px);
    border-color: rgba(6,182,212,0.25);
  }
  .infra-icon { font-size: 2rem; margin-bottom: 1rem; display: block; }
  .infra-card h4 { font-size: 1rem; font-weight: 700; margin-bottom: 0.4rem; }
  .infra-card p { font-size: 0.82rem; color: var(--text-secondary); line-height: 1.5; }
  .infra-card .infra-stat {
    margin-top: 1rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--cyan);
    padding: 0.3rem 0.75rem;
    border-radius: 0.25rem;
    background: rgba(6,182,212,0.08);
    border: 1px solid rgba(6,182,212,0.15);
    display: inline-block;
  }
  @media (max-width: 768px) {
    .infra-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 480px) {
    .infra-grid { grid-template-columns: 1fr; }
  }
", "dwsc-infra-styles")

let infra_section = dom.create("section", {
  id: "infrastructure",
  children: [
    dom.create("div", { className: "section-label reveal", text: "// BACKBONE" }),
    dom.create("h2", { className: "section-title gradient-text reveal", text: "Unified Infrastructure" }),
    dom.create("p", { className: "section-desc reveal", text: "Every ecosystem application shares the same authentication, payments, email, and communications backbone." }),
    dom.create("div", {
      className: "infra-grid",
      children: [
        dom.create("div", { className: "infra-card reveal", children: [
          dom.create("span", { className: "infra-icon", text: "🔐" }),
          dom.create("h4", { text: "Trust Layer SSO" }),
          dom.create("p", { text: "One identity across all 38 apps. Blockchain-verified hallmarks." }),
          dom.create("span", { className: "infra-stat", text: "38 apps connected" })
        ]}),
        dom.create("div", { className: "infra-card reveal", children: [
          dom.create("span", { className: "infra-icon", text: "📧" }),
          dom.create("h4", { text: "Resend" }),
          dom.create("p", { text: "Transactional email service. Welcome, notifications, and receipts." }),
          dom.create("span", { className: "infra-stat", text: "Email backbone" })
        ]}),
        dom.create("div", { className: "infra-card reveal", children: [
          dom.create("span", { className: "infra-icon", text: "💳" }),
          dom.create("h4", { text: "Stripe" }),
          dom.create("p", { text: "Unified payment processing with connected accounts per app." }),
          dom.create("span", { className: "infra-stat", text: "All commerce" })
        ]}),
        dom.create("div", { className: "infra-card reveal", children: [
          dom.create("span", { className: "infra-icon", text: "📱" }),
          dom.create("h4", { text: "Twilio" }),
          dom.create("p", { text: "SMS, voice, and WhatsApp messaging across the ecosystem." }),
          dom.create("span", { className: "infra-stat", text: "Communications" })
        ]})
      ]
    })
  ]
})
dom.mount(infra_section, "#app")


