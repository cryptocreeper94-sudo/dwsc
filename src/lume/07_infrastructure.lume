/// ─── ROADMAP TIMELINE ──────────────────────────────────────

dom.inject_css("
  .timeline {
    position: relative;
    max-width: 700px;
    margin: 2rem auto 0;
    padding-left: 2rem;
  }
  .timeline::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background: linear-gradient(to bottom, var(--cyan), var(--purple));
    opacity: 0.3;
  }
  .tl-item {
    position: relative;
    padding-left: 2rem;
    margin-bottom: 1.5rem;
  }
  .tl-item::before {
    content: '';
    position: absolute;
    left: -5px;
    top: 6px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: 2px solid var(--cyan);
    background: var(--void);
  }
  .tl-item.done::before {
    background: var(--cyan);
    box-shadow: 0 0 10px rgba(6,182,212,0.4);
  }
  .tl-item.current::before {
    background: var(--purple);
    border-color: var(--purple);
    box-shadow: 0 0 10px rgba(168,85,247,0.4);
    animation: pulse 2s ease infinite;
  }
  .tl-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--cyan);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 0.25rem;
  }
  .tl-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.25rem;
  }
  .tl-desc {
    font-size: 0.82rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }
  .tl-item.future .tl-title { color: var(--text-secondary); }
  .tl-item.future .tl-label { opacity: 0.5; }
  .tl-item.future::before {
    border-color: var(--text-dim);
    background: transparent;
  }
  @media (max-width: 480px) {
    .timeline { padding-left: 1.5rem; }
    .tl-item { padding-left: 1.5rem; }
  }
", "dwsc-timeline-styles")

let milestones = [
  { id: "M1-M7", title: "Core Compiler + English Mode + Security", desc: "Lexer, parser, transpiler, 102 patterns, 7-layer tolerance, 3-layer security, intent blocks.", status: "done" },
  { id: "M8", title: "Voice-to-Code Pipeline", desc: "7-step transcription cleanup, Web Speech API, homophone resolution, filler stripping.", status: "done" },
  { id: "M9", title: "Interactive Playground", desc: "In-browser compilation, sandboxed execution, multi-panel IDE with live preview.", status: "done" },
  { id: "M10", title: "Visual Context Awareness + LaaS", desc: "UI Element Registry, spatial terms, Lume as a Service (LaaS) cloud deployment. DWSC.io built entirely in Lume.", status: "done" },
  { id: "M11", title: "Reverse Mode (Code-to-Language)", desc: "lume explain — convert existing JS/TS to natural language annotations.", status: "current" },
  { id: "M12", title: "Collaborative Intent", desc: "Multi-developer compilation, AST-level diffing, intent-aware conflict resolution.", status: "future" },
  { id: "M13", title: "Zero-Dependency Runtime", desc: "Native binaries from natural language via Bun compile. One file in, one executable out.", status: "future" }
]

let timeline_div = dom.create("div", { className: "timeline" })
for (const m of milestones) {
  dom.add_child(timeline_div, dom.create("div", {
    className: "tl-item " + m.status + " reveal",
    children: [
      dom.create("div", { className: "tl-label", text: m.id }),
      dom.create("div", { className: "tl-title", text: m.title }),
      dom.create("div", { className: "tl-desc", text: m.desc })
    ]
  }))
}

let roadmap_section = dom.create("section", {
  id: "roadmap",
  children: [
    dom.create("div", { className: "section-label reveal", text: "// ROADMAP" }),
    dom.create("h2", { className: "section-title gradient-text reveal", text: "Development Timeline" }),
    dom.create("p", { className: "section-desc reveal", text: "13 milestones from concept to production-ready natural language compiler." }),
    timeline_div
  ]
})
dom.mount(roadmap_section, "#app")



dom.inject_css("
  .vert-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-top: 2rem;
  }
  .vert-grid .vert-row-2 {
    display: contents;
  }
  .vert-card {
    position: relative;
    border-radius: 1rem;
    overflow: hidden;
    background: var(--glass-bg);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid var(--glass-border);
    box-shadow: var(--glass-shadow);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.4s ease, box-shadow 0.4s ease;
    cursor: default;
    display: flex;
    flex-direction: column;
  }
  .vert-card:hover {
    transform: translateY(-6px);
    border-color: rgba(6, 182, 212, 0.3);
    box-shadow: 0 20px 60px rgba(6, 182, 212, 0.1), var(--glass-shadow);
  }
  .vert-card .vert-img {
    width: 100%;
    height: 180px;
    object-fit: cover;
    display: block;
    filter: brightness(0.85);
    transition: filter 0.4s ease;
  }
  .vert-card:hover .vert-img {
    filter: brightness(1);
  }
  .vert-card .vert-body {
    padding: 1.5rem;
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  .vert-card .vert-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--cyan);
    margin-bottom: 0.75rem;
    opacity: 0.8;
  }
  .vert-card .vert-badge .dot {
    width: 5px;
    height: 5px;
    background: var(--cyan);
    border-radius: 50%;
    animation: pulse 2s ease infinite;
  }
  .vert-card h3 {
    font-size: 1.15rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }
  .vert-card .vert-desc {
    font-size: 0.88rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 1rem;
    flex: 1;
  }
  .vert-card .vert-code {
    background: var(--primary);
    border: 1px solid var(--glass-border);
    border-radius: 0.5rem;
    padding: 0.75rem 1rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.6;
    color: var(--text-secondary);
    overflow-x: auto;
  }
  .vert-card .vert-code .kw { color: var(--purple); }
  .vert-card .vert-code .fn { color: var(--cyan); }
  .vert-card .vert-code .str { color: var(--teal); }
  .vert-card .vert-code .cm { color: var(--text-dim); }
  .vert-card.vert-wide {
    grid-column: span 2;
  }
  @media (max-width: 768px) {
    .vert-grid { grid-template-columns: 1fr; }
    .vert-card.vert-wide { grid-column: span 1; }
    .vert-card .vert-img { height: 160px; }
  }
", "dwsc-verticals-styles")

let verticals_section = dom.create("section", {
  id: "dual-ledger",
  children: [
    dom.create("div", { className: "section-label reveal", text: "// ARCHITECTURE" }),
    dom.create("h2", { className: "section-title gradient-text reveal", text: "The Dual-Ledger Model" }),
    dom.create("p", { className: "section-desc reveal", text: "The Enterprise Modernization Platform (EMP) separates operations from verification. It provides the speed and privacy of a centralized database, with the cryptographic certainty of a distributed ledger." }),

    dom.create("div", {
      className: "vert-grid reveal",
      children: [
        /// Private Ledger
        dom.create("div", { className: "vert-card", children: [
          dom.create("div", { className: "vert-body", children: [
            dom.create("div", { className: "vert-badge", children: [
              dom.create("span", { className: "dot" }),
              dom.create("span", { text: "Internal Operations" })
            ]}),
            dom.create("h3", { className: "gradient-text", text: "Private Ledger (CORE)" }),
            dom.create("p", { className: "vert-desc", text: "A high-speed, localized Deterministic Database running inside the enterprise firewall. It stores PII, trade secrets, and full payload operational data. Zero blockchain overhead." })
          ]})
        ]}),

        /// Public Ledger
        dom.create("div", { className: "vert-card", children: [
          dom.create("div", { className: "vert-body", children: [
            dom.create("div", { className: "vert-badge", children: [
              dom.create("span", { className: "dot", style: { background: "var(--purple)" } }),
              dom.create("span", { text: "External Verification", style: { color: "var(--purple)" } })
            ]}),
            dom.create("h3", { className: "gradient-text", text: "Public Ledger (TLL)" }),
            dom.create("p", { className: "vert-desc", text: "The Trust Layer Ledger. A distributed Proof-of-Authority chain that stores ONLY cryptographic hashes of the Private Ledger data. It provides immutable proof without data exposure." })
          ]})
        ]}),

        /// VET Bridge
        dom.create("div", { className: "vert-card", children: [
          dom.create("div", { className: "vert-body", children: [
            dom.create("div", { className: "vert-badge", children: [
              dom.create("span", { className: "dot", style: { background: "var(--teal)" } }),
              dom.create("span", { text: "Certification Layer", style: { color: "var(--teal)" } })
            ]}),
            dom.create("h3", { className: "gradient-text", text: "Verified Enterprise Trust (VET)" }),
            dom.create("p", { className: "vert-desc", text: "The cross-ledger verification bridge. When a third party needs to verify a record, VET compares the Private Ledger data against the Public Ledger hash to issue a cryptographic certificate of authenticity." })
          ]})
        ]}),

        /// DAIGS
        dom.create("div", { className: "vert-card vert-wide", children: [
          dom.create("div", { className: "vert-body", children: [
            dom.create("div", { className: "vert-badge", children: [
              dom.create("span", { className: "dot" }),
              dom.create("span", { text: "Governance" })
            ]}),
            dom.create("h3", { className: "gradient-text", text: "DAIGS Governance Engine" }),
            dom.create("p", { className: "vert-desc", text: "The Deterministic AI Governance Substrate (DAIGS) enforces strict logic rules across the entire dual-ledger architecture. It ensures that operations like LumeScan key management or Meridian Canon legal execution strictly adhere to predetermined constraints before any cryptographic hash is generated or anchored." }),
            dom.create("div", { className: "vert-code", html: '<span class="cm">// Deterministic Engine Constraint Example</span>\n<span class="kw">if</span> request.authorization_level <span class="fn">is less than</span> 3:\n  <span class="kw">reject</span> <span class="str">"Insufficient VET clearance for operation"</span>' })
          ]})
        ]})
      ]
    })
  ]
})
dom.mount(verticals_section, "#app")

