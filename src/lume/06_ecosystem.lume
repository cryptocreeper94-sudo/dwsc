    ]
  }
]

let active_cat = state.reactive(0)
let cat_positions = []

/// Build tab buttons
let tab_container = dom.create("div", { className: "cat-tabs" })
for (let c = 0; c < categories.length; c++) {
  let tab_btn = dom.create("button", {
    className: "cat-tab" + (c === 0 ? " active" : ""),
    text: categories[c].name,
    attrs: { "data-cat-idx": c + "" }
  })
  dom.on(tab_btn, "click", () => {
    active_cat.set(c)
  })
  dom.add_child(tab_container, tab_btn)
}

/// Build category carousel panels
let panels_wrapper = dom.create("div", { styles: { position: "relative" } })

for (let c = 0; c < categories.length; c++) {
  let cat = categories[c]
  let cat_slide_pos = state.reactive(0)
  cat_positions.push(cat_slide_pos)
  let slides_count = Math.ceil(cat.apps.length / 2)

  let cat_track = dom.create("div", { className: "cat-track" })
  for (let s = 0; s < slides_count; s++) {
    let slide = dom.create("div", { styles: { minWidth: "100%", display: "flex" } })
    for (let a = s * 2; a < Math.min((s + 1) * 2, cat.apps.length); a++) {
      let app = cat.apps[a]
      let card = dom.create("div", {
        className: "cat-card",
        children: [
          dom.create("div", { className: "cat-card-icon", text: app.icon }),
          dom.create("h4", { text: app.name }),
          dom.create("p", { text: app.desc }),
          dom.create("a", { className: "cat-link", text: app.url !== "#" ? "Visit →" : "Coming Soon", attrs: { href: app.url, target: "_blank" } })
        ]
      })
      dom.add_child(slide, card)
    }
    dom.add_child(cat_track, slide)
  }

  /// Dots
  let dots_div = dom.create("div", { className: "cat-dots" })
  for (let d = 0; d < slides_count; d++) {
    let dot = dom.create("button", {
      className: "cat-dot" + (d === 0 ? " active" : ""),
      attrs: { "data-dot-cat": c + "", "data-dot-idx": d + "" }
    })
    dom.on(dot, "click", () => { cat_positions[c].set(d) })
    dom.add_child(dots_div, dot)
  }

  /// Arrows
  let prev_btn = dom.create("button", { className: "cat-arrow", text: "←" })
  dom.on(prev_btn, "click", () => {
    let cur = cat_positions[c].get()
    if (cur > 0) cat_positions[c].set(cur - 1)
  })
  let next_btn = dom.create("button", { className: "cat-arrow", text: "→" })
  dom.on(next_btn, "click", () => {
    let cur = cat_positions[c].get()
    let max_s = Math.ceil(cat.apps.length / 2) - 1
    if (cur < max_s) cat_positions[c].set(cur + 1)
  })

  let nav_bar = dom.create("div", { className: "cat-nav", children: [prev_btn, dots_div, next_btn] })

  /// Slide position tracking
  cat_slide_pos.on_change((val) => {
    cat_track.style.transform = "translateX(-" + (val * 100) + "%)"
    let all_dots = dots_div.querySelectorAll(".cat-dot")
    for (const dt of all_dots) { dt.classList.remove("active") }
    if (all_dots[val]) all_dots[val].classList.add("active")
  })

  let panel = dom.create("div", {
    className: "cat-carousel",
    styles: { display: c === 0 ? "block" : "none" },
    attrs: { "data-cat-panel": c + "" },
    children: [cat_track, nav_bar]
  })
  dom.add_child(panels_wrapper, panel)
}

/// Tab switching
active_cat.on_change((val) => {
  let all_tabs = dom.select_all(".cat-tab")
  for (const t of all_tabs) { t.classList.remove("active") }
  if (all_tabs[val]) all_tabs[val].classList.add("active")
  let all_panels = dom.select_all("[data-cat-panel]")
  for (const p of all_panels) { p.style.display = "none" }
  let active_panel = dom.select("[data-cat-panel='" + val + "']")
  if (active_panel) active_panel.style.display = "block"
})

let cat_section = dom.create("section", {
  id: "categories",
  children: [
    dom.create("div", { className: "section-label reveal", text: "// 38 APPLICATIONS" }),
    dom.create("h2", { className: "section-title gradient-text reveal", text: "Ecosystem by Category" }),
    dom.create("p", { className: "section-desc reveal", text: "Every application unified by Trust Layer SSO, Stripe payments, Resend email, and Twilio communications. Browse by vertical." }),
    dom.create("div", { className: "reveal", children: [tab_container, panels_wrapper] })
  ]
})
dom.mount(cat_section, "#app")

