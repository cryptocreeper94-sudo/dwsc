dom.inject_css("
  .arch-container {
    position: relative;
    width: 100%;
    max-width: 700px;
    margin: 0 auto;
    aspect-ratio: 1;
  }
  .arch-hub {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 120px;
    height: 120px;
    border-radius: 50%;
    background: linear-gradient(135deg, rgba(6,182,212,0.15), rgba(168,85,247,0.1));
    border: 2px solid rgba(6,182,212,0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    z-index: 10;
    box-shadow: 0 0 40px rgba(6,182,212,0.15);
  }
  .arch-hub-icon { font-size: 1.5rem; margin-bottom: 0.25rem; }
  .arch-hub-label { font-size: 0.65rem; font-weight: 700; color: var(--cyan); text-transform: uppercase; letter-spacing: 0.1em; text-align: center; }
  .arch-ring {
    position: absolute;
    top: 50%;
    left: 50%;
    border: 1px solid rgba(6,182,212,0.08);
    border-radius: 50%;
    transform: translate(-50%, -50%);
  }
  .arch-node {
    position: absolute;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.2rem;
    cursor: pointer;
    transition: all 0.3s ease;
    z-index: 5;
  }
  .arch-node:hover {
    border-color: rgba(6,182,212,0.4);
    transform: scale(1.15);
    box-shadow: 0 0 20px rgba(6,182,212,0.2);
  }
  .arch-node .arch-tooltip {
    position: absolute;
    bottom: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%);
    padding: 0.4rem 0.75rem;
    border-radius: 0.5rem;
    background: var(--primary);
    border: 1px solid rgba(6,182,212,0.2);
    white-space: nowrap;
    font-size: 0.7rem;
    color: var(--text-primary);
    font-weight: 600;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s;
  }
  .arch-node:hover .arch-tooltip { opacity: 1; }
  @keyframes orbit-pulse {
    0%, 100% { opacity: 0.08; }
    50% { opacity: 0.15; }
  }
  @media (max-width: 768px) {
    .arch-container { max-width: 360px; }
    .arch-hub { width: 80px; height: 80px; }
    .arch-hub-icon { font-size: 1.1rem; }
    .arch-hub-label { font-size: 0.5rem; }
    .arch-node { width: 36px; height: 36px; font-size: 0.8rem; }
  }
  @media (max-width: 480px) {
    .arch-container { max-width: 280px; }
    .arch-hub { width: 64px; height: 64px; }
    .arch-node { width: 30px; height: 30px; font-size: 0.7rem; }
  }
", "dwsc-arch-styles")

/// Build the hub-and-spoke nodes
let arch_apps = [
  { icon: "🔐", name: "Trust Layer SSO", cat: "core" },
  { icon: "◈", name: "TrustGen 3D", cat: "dev" },
  { icon: "🎵", name: "DarkWave Studio", cat: "dev" },
  { icon: "💬", name: "Signal Chat", cat: "social" },
  { icon: "🏗️", name: "DW Studio IDE", cat: "dev" },
  { icon: "🎓", name: "DarkWave Academy", cat: "edu" },
  { icon: "💎", name: "Lume Lang", cat: "dev" },
  { icon: "🎮", name: "Bomber 3D", cat: "game" },
  { icon: "🌳", name: "Arbora", cat: "social" },
  { icon: "🎲", name: "Chronicles", cat: "game" },
  { icon: "🍺", name: "BrewBoard", cat: "comm" },
  { icon: "🎨", name: "PaintPros", cat: "comm" },
  { icon: "🏠", name: "TrustHome", cat: "comm" },
  { icon: "📊", name: "Verdara", cat: "ent" },
  { icon: "🌿", name: "Bloom", cat: "social" },
  { icon: "📰", name: "Newsroom", cat: "social" },
  { icon: "🔧", name: "Deploy Engine", cat: "infra" },
  { icon: "✅", name: "Verify Keyword", cat: "infra" },
  { icon: "🔗", name: "Hallmarks", cat: "core" },
  { icon: "📝", name: "Trust Stamps", cat: "core" },
  { icon: "🍔", name: "Happy Eats", cat: "comm" }
]

let arch_container = dom.create("div", { className: "arch-container" })

/// Hub
dom.add_child(arch_container, dom.create("div", {
  className: "arch-hub",
  children: [
    dom.create("div", { className: "arch-hub-icon", text: "🛡️" }),
    dom.create("div", { className: "arch-hub-label", text: "Trust Layer" })
  ]
}))

/// Rings
let ring_sizes = [240, 340, 440]
for (const size of ring_sizes) {
  dom.add_child(arch_container, dom.create("div", {
    className: "arch-ring",
    styles: { width: size + "px", height: size + "px", animation: "orbit-pulse 4s ease infinite " + (size / 100) + "s" }
  }))
}

/// Position nodes around rings
for (let i = 0; i < arch_apps.length; i++) {
  let app = arch_apps[i]
  let ring = i < 6 ? 0 : (i < 13 ? 1 : 2)
  let ring_radius = ring_sizes[ring] / 2
  let items_on_ring = ring === 0 ? 6 : (ring === 1 ? 7 : 7)
  let idx_on_ring = ring === 0 ? i : (ring === 1 ? i - 6 : i - 13)
  let angle = (idx_on_ring / items_on_ring) * 2 * 3.14159 - 1.5708
  let cx = 50 + (ring_radius / 3.5) * Math.cos(angle)
  let cy = 50 + (ring_radius / 3.5) * Math.sin(angle)

  let node = dom.create("div", {
    className: "arch-node",
    styles: { left: cx + "%", top: cy + "%", transform: "translate(-50%, -50%)" },
    children: [
      dom.create("span", { text: app.icon }),
      dom.create("span", { className: "arch-tooltip", text: app.name })
    ]
  })
  dom.add_child(arch_container, node)
}

let arch_section = dom.create("section", {
  id: "architecture",
  children: [
    dom.create("div", { className: "section-label reveal", text: "// ARCHITECTURE" }),
    dom.create("h2", { className: "section-title gradient-text reveal", text: "Ecosystem Architecture" }),
    dom.create("p", { className: "section-desc reveal", text: "All applications connect through Trust Layer SSO — one identity, one authentication, one ecosystem." }),
    dom.create("div", { className: "reveal", children: [arch_container] })
  ]
})
dom.mount(arch_section, "#app")


