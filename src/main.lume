    font-weight: 700;
    font-family: var(--font-mono);
    background: var(--primary);
    border: 1px solid var(--glass-border);
    border-radius: 0.75rem;
    color: var(--cyan);
    outline: none;
    transition: border-color 0.2s;
  }
  .pin-digit:focus {
    border-color: var(--cyan);
    box-shadow: 0 0 12px rgba(6, 182, 212, 0.2);
  }
  .pin-error {
    color: #ef4444;
    font-size: 0.85rem;
    margin-top: 0.5rem;
    min-height: 1.25rem;
  }
  .portal-enter-btn {
    padding: 0.75rem 2.5rem;
    border-radius: 2rem;
    background: linear-gradient(135deg, var(--cyan), #0891b2);
    border: none;
    color: #fff;
    font-size: 0.95rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.3s ease;
  }
  .portal-enter-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(6, 182, 212, 0.3);
  }

  /* ── Portal Dashboard ── */
  .portal-dashboard {
    max-width: 1100px;
    margin: 0 auto;
    padding: 5rem 2rem 3rem;
  }
  .portal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--glass-border);
  }
  .portal-header h1 {
    font-size: 1.8rem;
    font-weight: 800;
  }
  .portal-exit-btn {
    padding: 0.5rem 1.25rem;
    border-radius: 2rem;
    background: rgba(239, 68, 68, 0.1);
    border: 1px solid rgba(239, 68, 68, 0.3);
    color: #ef4444;
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
  }
  .portal-exit-btn:hover {
    background: rgba(239, 68, 68, 0.2);
  }
  .portal-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    margin-bottom: 2rem;
  }
  .portal-card {
    padding: 1.5rem;
    border-radius: 1rem;
    background: var(--glass-bg);
    backdrop-filter: blur(20px);
    border: 1px solid var(--glass-border);
    box-shadow: var(--glass-shadow);
  }
  .portal-card .portal-card-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--cyan);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: 0.5rem;
  }
  .portal-card .portal-card-value {
    font-size: 2rem;
    font-weight: 900;
  }
  .portal-card .portal-card-sub {
    font-size: 0.8rem;
    color: var(--text-secondary);
    margin-top: 0.25rem;
  }
  .portal-section {
    margin-bottom: 2rem;
  }
  .portal-section h3 {
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: 1rem;
    color: var(--cyan);
  }
  .health-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
  }
  .health-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    border-radius: 0.75rem;
    background: var(--primary);
    border: 1px solid var(--glass-border);
    font-size: 0.85rem;
  }
  .health-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .health-dot.up { background: #22c55e; box-shadow: 0 0 8px rgba(34, 197, 94, 0.5); }
  .health-dot.down { background: #ef4444; box-shadow: 0 0 8px rgba(239, 68, 68, 0.5); }
  .health-dot.checking { background: #eab308; animation: pulse 1s ease infinite; }
  .health-name { flex: 1; color: var(--text-secondary); }
  .health-status { font-family: var(--font-mono); font-size: 0.75rem; }
  .health-status.up { color: #22c55e; }
  .health-status.down { color: #ef4444; }
  .health-status.checking { color: #eab308; }

  .blog-mgmt-table {
    width: 100%;
    border-collapse: collapse;
  }
  .blog-mgmt-table th {
    text-align: left;
    padding: 0.6rem 1rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--cyan);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border-bottom: 1px solid var(--glass-border);
  }
  .blog-mgmt-table td {
    padding: 0.75rem 1rem;
    font-size: 0.85rem;
    color: var(--text-secondary);
    border-bottom: 1px solid rgba(255,255,255,0.04);
  }
  .blog-mgmt-table tr:hover td {
    background: rgba(6, 182, 212, 0.03);
  }
  .quick-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .quick-action-btn {
    padding: 0.5rem 1.25rem;
    border-radius: 2rem;
    background: rgba(6, 182, 212, 0.06);
    border: 1px solid rgba(6, 182, 212, 0.15);
    color: var(--cyan);
    font-size: 0.8rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s;
    text-decoration: none;
  }
  .quick-action-btn:hover {
    background: rgba(6, 182, 212, 0.12);
    border-color: rgba(6, 182, 212, 0.3);
  }
  .portal-timestamp {
    text-align: center;
    padding: 1.5rem;
    font-size: 0.75rem;
    color: var(--text-dim);
    font-family: var(--font-mono);
  }
  @media (max-width: 768px) {
    .portal-grid { grid-template-columns: 1fr; }
    .health-grid { grid-template-columns: 1fr; }
    .pin-digit { width: 44px; height: 52px; font-size: 1.2rem; }
  }
", "dwsc-portal-styles")


/// ─── PORTAL ANALYTICS TRACKER ──────────────────────────────

/// Track page views in localStorage
dom.ready(() => {
  let views = parseInt(localStorage.getItem("dwsc_views") || "0")
  localStorage.setItem("dwsc_views", String(views + 1))

  let sessions = parseInt(localStorage.getItem("dwsc_sessions") || "0")
  if (!sessionStorage.getItem("dwsc_session_active")) {
    sessionStorage.setItem("dwsc_session_active", "1")
    localStorage.setItem("dwsc_sessions", String(sessions + 1))
  }

  /// Track referrer
  if (document.referrer) {
    let refs = JSON.parse(localStorage.getItem("dwsc_referrers") || "[]")
    refs.push({ url: document.referrer, time: Date.now() })
    if (refs.length > 100) refs = refs.slice(-100)
    localStorage.setItem("dwsc_referrers", JSON.stringify(refs))
  }

  /// Track page load times
  let loadTimes = JSON.parse(localStorage.getItem("dwsc_load_times") || "[]")
  let loadTime = performance.now()
  loadTimes.push({ time: Date.now(), ms: Math.round(loadTime) })
  if (loadTimes.length > 50) loadTimes = loadTimes.slice(-50)
  localStorage.setItem("dwsc_load_times", JSON.stringify(loadTimes))
})


/// ─── PORTAL ROUTE HANDLER ──────────────────────────────────

dom.ready(() => {
  let PORTAL_PIN = "0424"
  let portalAuthenticated = false

  function showPortalAuth() {
    let app = dom.select("#app")
    let existing = dom.select("#portal-view")
    if (existing) existing.remove()
    app.style.display = "none"
    window.scrollTo(0, 0)

    let errorMsg = dom.create("div", { className: "pin-error", text: "" })

    let digits = []
    let pinRow = dom.create("div", { className: "pin-input-row" })
    for (let i = 0; i < 4; i++) {
      let input = dom.create("input", {
        className: "pin-digit",
        attrs: { type: "password", maxlength: "1", inputmode: "numeric", autocomplete: "off" }
      })
      input.addEventListener("input", (e) => {
        if (e.target.value.length === 1 && i < 3) {
          digits[i + 1].focus()
        }
        errorMsg.textContent = ""
      })
      input.addEventListener("keydown", (e) => {
        if (e.key === "Backspace" && !e.target.value && i > 0) {
          digits[i - 1].focus()
        }
        if (e.key === "Enter") {
          attemptLogin()
        }
      })
      digits.push(input)
      pinRow.appendChild(input)
    }

    function attemptLogin() {
      let pin = digits.map(d => d.value).join("")
      if (pin === PORTAL_PIN) {
        portalAuthenticated = true
        showPortalDashboard()
      } else {
        errorMsg.textContent = "Invalid PIN. Access denied."
        digits.forEach(d => { d.value = ""; d.style.borderColor = "#ef4444" })
        digits[0].focus()
        setTimeout(() => digits.forEach(d => d.style.borderColor = ""), 1500)
      }
    }

    let enterBtn = dom.create("button", {
      className: "portal-enter-btn",
      text: "◈ Enter Portal",
      onClick: attemptLogin
    })

    let authView = dom.create("div", {
      id: "portal-view",
      className: "portal-auth",
      children: [
        dom.create("div", {
          className: "portal-auth-card",
          children: [
            dom.create("div", { className: "nav-logo gradient-text", text: "DWSC", styles: { fontSize: "1.3rem", marginBottom: "1rem" } }),
            dom.create("h2", { text: "Developer Portal" }),
            dom.create("p", { className: "portal-sub", text: "Enter your 4-digit developer PIN" }),
            pinRow,
            errorMsg,
            enterBtn
          ]
        })
      ]
    })

    document.body.appendChild(authView)
    setTimeout(() => digits[0].focus(), 100)
  }

  function showPortalDashboard() {
    let app = dom.select("#app")
    let existing = dom.select("#portal-view")
    if (existing) existing.remove()
    app.style.display = "none"
    window.scrollTo(0, 0)

    /// Gather analytics
    let totalViews = localStorage.getItem("dwsc_views") || "0"
    let totalSessions = localStorage.getItem("dwsc_sessions") || "0"
    let referrers = JSON.parse(localStorage.getItem("dwsc_referrers") || "[]")
    let loadTimes = JSON.parse(localStorage.getItem("dwsc_load_times") || "[]")
    let avgLoad = loadTimes.length > 0 ? Math.round(loadTimes.reduce((s, t) => s + t.ms, 0) / loadTimes.length) : 0

    /// Unique referrer domains
    let refDomains = {}
    referrers.forEach(r => {
      try {
        let domain = new URL(r.url).hostname
        refDomains[domain] = (refDomains[domain] || 0) + 1
      } catch {}
    })
    let topRefs = Object.entries(refDomains).sort((a, b) => b[1] - a[1]).slice(0, 5)

    /// Build health check items
    let healthTargets = [
      { name: "dwtl.io", url: "https://dwtl.io" },
      { name: "TrustGen", url: "https://trustgen.tlid.io" },
      { name: "Lume Lang", url: "https://lume-lang.com" },
      { name: "DarkWave Studios", url: "https://darkwavestudios.io" },
      { name: "Trust Hub", url: "https://trusthub.tlid.io" },
      { name: "DWSC.io", url: "https://dwsc.io" }
    ]

    let healthGrid = dom.create("div", { className: "health-grid" })
    healthTargets.forEach(target => {
      let dot = dom.create("span", { className: "health-dot checking" })
      let status = dom.create("span", { className: "health-status checking", text: "checking..." })
      let item = dom.create("div", {
        className: "health-item",
        children: [
          dot,
          dom.create("span", { className: "health-name", text: target.name }),
          status
        ]
      })
      healthGrid.appendChild(item)

      /// Ping with fetch
      fetch(target.url, { method: "HEAD", mode: "no-cors", cache: "no-store" })
        .then(() => {
          dot.className = "health-dot up"
          status.className = "health-status up"
          status.textContent = "● online"
        })
        .catch(() => {
          dot.className = "health-dot down"
          status.className = "health-status down"
          status.textContent = "● offline"
        })
    })

    /// Blog management table
    let blogTable = dom.create("table", { className: "blog-mgmt-table" })
    let thead = dom.create("thead", { html: "<tr><th>Title</th><th>Category</th><th>Read Time</th><th>Date</th></tr>" })
    blogTable.appendChild(thead)
    let tbody = dom.create("tbody")
    blog_posts.forEach(post => {
      let row = dom.create("tr", {
        html: "<td>" + post.title + "</td><td>" + post.category + "</td><td>" + post.readTime + "</td><td>" + post.date + "</td>"
      })
      tbody.appendChild(row)
    })
    blogTable.appendChild(tbody)

    /// Referrer list
    let refList = topRefs.length > 0
      ? topRefs.map(r => dom.create("div", { className: "health-item", children: [
          dom.create("span", { className: "health-name", text: r[0] }),
          dom.create("span", { className: "health-status up", text: r[1] + " visits" })
        ]}))
      : [dom.create("div", { className: "health-item", children: [
          dom.create("span", { className: "health-name", text: "No referrers tracked yet" })
        ]})]

    let dashboard = dom.create("div", {
      id: "portal-view",
      className: "portal-dashboard",
      children: [
        /// Header
        dom.create("div", {
          className: "portal-header",
          children: [
            dom.create("h1", { className: "gradient-text", text: "◈ Developer Portal" }),
            dom.create("button", {
              className: "portal-exit-btn",
              text: "✕ Exit Portal",
              onClick: () => {
                window.location.hash = ""
                dashboard.remove()
                app.style.display = ""
                portalAuthenticated = false
              }
            })
          ]
        }),

        /// Stats cards
        dom.create("div", {
          className: "portal-grid",
          children: [
            dom.create("div", { className: "portal-card", children: [
              dom.create("div", { className: "portal-card-label", text: "PAGE VIEWS" }),
              dom.create("div", { className: "portal-card-value gradient-text", text: totalViews }),
              dom.create("div", { className: "portal-card-sub", text: "All time (local)" })
            ]}),
            dom.create("div", { className: "portal-card", children: [
              dom.create("div", { className: "portal-card-label", text: "SESSIONS" }),
              dom.create("div", { className: "portal-card-value gradient-text", text: totalSessions }),
              dom.create("div", { className: "portal-card-sub", text: "Unique visits" })
            ]}),
            dom.create("div", { className: "portal-card", children: [
              dom.create("div", { className: "portal-card-label", text: "AVG LOAD" }),
              dom.create("div", { className: "portal-card-value gradient-text", text: avgLoad + "ms" }),
              dom.create("div", { className: "portal-card-sub", text: "Last " + loadTimes.length + " loads" })
            ]})
          ]
        }),

        /// System health
        dom.create("div", {
          className: "portal-section",
          children: [
            dom.create("h3", { text: "🔒 System Health" }),
            healthGrid
          ]
        }),

        /// Referrers
        dom.create("div", {
          className: "portal-section",
          children: [
            dom.create("h3", { text: "📊 Top Referrers" }),
            dom.create("div", { className: "health-grid", children: refList })
          ]
        }),

        /// Blog management
        dom.create("div", {
          className: "portal-section",
          children: [
            dom.create("h3", { text: "📝 Blog Posts (" + blog_posts.length + ")" }),
            blogTable
          ]
        }),

        /// Quick actions
        dom.create("div", {
          className: "portal-section",
          children: [
            dom.create("h3", { text: "⚡ Quick Actions" }),
            dom.create("div", {
              className: "quick-actions",
              children: [
                dom.create("a", { className: "quick-action-btn", text: "📄 View Papers", attrs: { href: "#papers" } }),
                dom.create("a", { className: "quick-action-btn", text: "📝 View Blog", attrs: { href: "#blog" } }),
                dom.create("a", { className: "quick-action-btn", text: "🌐 dwtl.io", attrs: { href: "https://dwtl.io", target: "_blank" } }),
                dom.create("a", { className: "quick-action-btn", text: "◈ TrustGen IDE", attrs: { href: "https://trustgen.tlid.io", target: "_blank" } }),
                dom.create("a", { className: "quick-action-btn", text: "📦 GitHub", attrs: { href: "https://github.com/cryptocreeper94-sudo/dwsc", target: "_blank" } }),
                dom.create("button", {
                  className: "quick-action-btn",
                  text: "🗑️ Reset Analytics",
                  onClick: () => {
                    localStorage.removeItem("dwsc_views")
                    localStorage.removeItem("dwsc_sessions")
                    localStorage.removeItem("dwsc_referrers")
                    localStorage.removeItem("dwsc_load_times")
                    alert("Analytics reset. Refresh to see changes.")
                  }
                })
              ]
            })
          ]
        }),

        /// Timestamp
        dom.create("div", {
          className: "portal-timestamp",
          text: "DWSC Developer Portal · Built with Lume · " + new Date().toLocaleString()
        })
      ]
    })

    document.body.appendChild(dashboard)
  }

  /// Route handler for #portal
  function handlePortalRoute() {
    if (window.location.hash === "#portal") {
      if (portalAuthenticated) {
        showPortalDashboard()
      } else {
        showPortalAuth()
      }
    }
  }

  window.addEventListener("hashchange", handlePortalRoute)
  handlePortalRoute()
})



